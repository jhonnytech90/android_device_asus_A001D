# init.A001D.rc — ASUS ZenFone Max Shot / Plus M2 (A001D / ZB634KL)
# LineageOS 17.1 — Android 10

on init
    # Symlink de bootdevice para MSM8953
    symlink /dev/block/platform/soc/7824900.sdhci /dev/block/bootdevice

    # Scheduler tuning inicial
    write /sys/block/mmcblk0/queue/read_ahead_kb 512

on fs
    mount_all /vendor/etc/fstab.qcom
    restorecon_recursive /mnt/vendor/persist

on post-fs
    # Persist — dados de licença
    mkdir /mnt/vendor/persist/data/pfm/licenses 0771 system system

on post-fs-data
    # Câmera — tripla câmera ASUS A001D
    mkdir /data/vendor/camera 0770 camera camera

    # Fingerprint — Goodix GF3208 (traseiro)
    mkdir /data/vendor/fingerprint 0770 system system

    # GPS / Location
    mkdir /data/vendor/location 0770 gps gps
    mkdir /data/vendor/location/mq 0770 gps gps

    # Wi-Fi
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

    # RIL
    mkdir /data/vendor/ril 0770 radio radio

on property:sys.boot_completed=1
    # I/O scheduler — MSM8953: homogêneo Cortex-A53 octa-core
    write /sys/block/mmcblk0/queue/scheduler cfq
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/mmcblk0/queue/rq_affinity 0
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 128

    # CPU Governor
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor interactive

    # Tap-to-wake
    write /proc/touchpanel/wakeup_gesture 1

    # VM tweaks para Android 10
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 100

on property:ro.boot.baseband=msm
    start vendor.rild

# Fingerprint HAL — Goodix
service vendor.fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.1-service
    class hal
    user system
    group system input
    writepid /dev/cpuset/system-background/tasks

# HVDCP — A001D usa carregador 10W (sem Quick Charge)
service hvdcp_opti /vendor/bin/hvdcp_opti
    class main
    user root
    group system wakelock
    writepid /dev/cpuset/system-background/tasks

# Power-off alarm
service power_off_alarm /vendor/bin/power_off_alarm
    class core
    group system
    disabled
    oneshot
