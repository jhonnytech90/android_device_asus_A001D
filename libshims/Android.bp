// Shim para câmera MSM8953 (blobs Oreo no Android 10)
// Símbolos específicos preenchidos após análise dos blobs via readelf
// FASE 2: completar após receber os blobs extraídos
cc_library_shared {
    name: "libshims_camera",
    defaults: ["hidl_defaults"],

    srcs: [
        // Arquivos fonte serão adicionados na Fase 2
        // após identificar símbolos faltando com:
        //   readelf -d vendor/lib/hw/camera.msm8953.so
        //   readelf -d vendor/lib64/hw/camera.msm8953.so
        "camera_shim.cpp",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libbase",
    ],

    vendor: true,
}
